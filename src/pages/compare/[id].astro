---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getEntryBySlug, getCollection } from 'astro:content';

// Required for dynamic routes
export async function getStaticPaths() {
  const comparisons = await getCollection('comparisons');
  return comparisons.map((comp) => ({
    params: { id: comp.id },
    props: { comparison: comp }
  }));
}

const comparison = getEntryBySlug('comparisons', Astro.params.id);

if (!comparison) {
  throw new Error('Comparison not found');
}

const toolA = await getEntryBySlug('tools', comparison.data.toolA);
const toolB = await getEntryBySlug('tools', comparison.data.toolB);

if (!toolA || !toolB) {
  throw new Error('Comparison tool not found');
}
---

<BaseLayout 
  title={(comparison.data.toolAName ? comparison.data.toolAName : comparison.data.toolA) + ' vs ' + (comparison.data.toolBName ? comparison.data.toolBName : comparison.data.toolB) + ' | Freemium.Services'}
  description="Detailed comparison of " + (comparison.data.toolAName || comparison.data.toolA) + " and " + (comparison.data.toolBName || comparison.data.toolB)
>
  <div class="max-w-4xl mx-auto">
    <h1 class="text-3xl font-bold mb-6">
      {(comparison.data.toolAName || comparison.data.toolA) + ' vs ' + (comparison.data.toolBName || comparison.data.toolB)}
    </h1>
    
    <div class="bg-blue-50 border border-blue-200 rounded-lg p-4 mb-8">
      <h2 class="text-lg font-bold mb-2">Verdict</h2>
      <p>{comparison.data.verdict}</p>
    </div>
    
    <div class="overflow-x-auto mb-8">
      <table class="min-w-full border border-gray-200 rounded-lg overflow-hidden">
        <thead class="bg-gray-50">
          <tr>
            <th class="border px-4 py-2 text-left font-medium text-gray-700">Feature</th>
            <th class="border px-4 py-2 text-center font-medium text-gray-700">{(comparison.data.toolAName || comparison.data.toolA)}</th>
            <th class="border px-4 py-2 text-center font-medium text-gray-700">{(comparison.data.toolBName || comparison.data.toolB)}</th>
          </tr>
        </thead>
        <tbody>
          {comparison.data.features.map((feature) => (
            <tr>
              <td class="border px-4 py-2 text-sm font-medium text-gray-900">{feature.name}</td>
              <td class="border px-4 py-2 text-center text-sm">
                {typeof feature.valA === 'boolean' ? (feature.valA ? '✓' : '✗') : feature.valA}
              </td>
              <td class="border px-4 py-2 text-center text-sm">
                {typeof feature.valB === 'boolean' ? (feature.valB ? '✓' : '✗') : feature.valB}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    
    <div class="text-sm text-gray-500">
      <p>Last updated: {new Date().toISOString().split('T')[0]}</p>
    </div>
  </div>
</BaseLayout>